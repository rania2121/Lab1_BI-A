from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager
from selenium.webdriver.common.by import By
import json
import time

options=webdriver.ChromeOptions()

driver=webdriver.Chrome(
    service=Service(ChromeDriverManager().install()),
    options=options
)

all_products=[]

for page in range(1, 4):

    url=f"https://www.producthunt.com/search?q=mental+health+ai&page={page}"

    print(f"Scraping page {page}...")

    driver.get(url)
    print(driver.page_source)
    time.sleep(8)

    cards=driver.find_elements(By.CSS_SELECTOR, "div[data-test='product-item']")

    print("Produits trouvés :", len(cards))

    for idx, card in enumerate(cards, start=1):

        try:
            name=card.find_element(By.TAG_NAME, "h3").text
        except:
            name="N/A"

        try:
            tagline=card.find_element(By.TAG_NAME, "p").text
        except:
            tagline="N/A"

        all_products.append({
            "page": page,
            "id": idx,
            "name": name,
            "tagline": tagline
        })

   
    with open("products_all.json", "w", encoding="utf-8") as f:
        json.dump(all_products, f, indent=4, ensure_ascii=False)

print("products_all.json sauvegardé !")

driver.quit()